# .env.docker.example
# Скопируйте этот файл в .env.docker и настройте под свои нужды
# cp .env.docker.example .env.docker

# === Application ===
APP_ENV=docker

# === Database ===
POSTGRES_USER=panoramdle_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=newsdb
POSTGRES_HOST=panoramdle_db

# === Nginx / Deployment ===
# Домен сайта (используйте _ для любого домена/IP в dev режиме)
DOMAIN=_

# Порт backend контейнера
BACKEND_PORT=8000

# Путь к проекту на сервере (настройте при деплое)
PROJECT_PATH=/path/to/your/project