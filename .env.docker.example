# .env.docker.example
# Production environment configuration
#
# Setup:
#   1. Copy this file: cp .env.docker.example .env.docker
#   2. Edit .env.docker with your actual values
#   3. Never commit .env.docker to git!

# ===================================
# Application
# ===================================
APP_ENV=docker

# ===================================
# Database Configuration
# ===================================
POSTGRES_USER=panoramdle_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=newsdb
POSTGRES_HOST=panoramdle_db
POSTGRES_PORT=5432

# ===================================
# Backend Configuration
# ===================================
# Port on which backend is accessible on the host
BACKEND_PORT=8000

# ===================================
# Nginx / Deployment
# ===================================
# Domain name (use _ for any domain/IP in development)
DOMAIN=_

# Project path on server (configure for deployment)
PROJECT_PATH=/var/www/panoramdle

# ===================================
# Default Admin Credentials
# ===================================
# Used for automatic admin creation on first run
# IMPORTANT: Change these in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately
ADMIN_EMAIL=admin@panoramdle.com