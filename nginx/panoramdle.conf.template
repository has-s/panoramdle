# nginx/panoramdle.conf.template
# Template для генерации Nginx конфигурации
# Используйте: ./scripts/nginx_reload.sh install

upstream panoramdle_backend {
    server 127.0.0.1:BACKEND_PORT;
    keepalive 32;
}

server {
    listen 80;
    server_name DOMAIN_NAME;

    client_max_body_size 20M;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://panoramdle_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    location /static/ {
        alias PROJECT_PATH/backend/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /health {
        proxy_pass http://panoramdle_backend;
        access_log off;
    }

    access_log /var/log/nginx/panoramdle_access.log;
    error_log /var/log/nginx/panoramdle_error.log;
}